# Fill in these values before running the backend (or export them in your shell / IDE run configuration)

# PostgreSQL with the PostGIS extension (e.g. a Supabase project)
DB_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require
DB_USERNAME=<db-username>
DB_PASSWORD=<db-password>

# Base64-encoded key, at least 256 bits. Generate one with: openssl rand -base64 32
JWT_SECRET=<base64-secret>
JWT_EXPIRATION_MS=1800000

# Comma-separated list of frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:4200
